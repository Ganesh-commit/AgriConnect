PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/agriconnect
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
CLIENT_URL=http://localhost:5173
PEXELS_API_KEY=your_pexels_api_key_here

# Optional Cloudinary Configuration (Leave blank to use local fallback /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================================
# 1. MULTI-PROVIDER LLM LAYER (Gemini + Ollama + Anthropic Stub)
# ============================================================================
# Comma-separated fallback priority order (tries providers in order, skips unconfigured)
LLM_PROVIDER_ORDER=gemini,ollama

# Primary Cloud Provider: Google Gemini API (official endpoint / @google/genai)
# Get a free API key at https://aistudio.google.com/app/apikey
# Current free-tier Flash model per https://ai.google.dev/gemini-api/docs/models: gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Fallback & Offline/Privacy Provider: Ollama (native /api/chat)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision

# Optional Paid Stub: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Privacy, Cache & Reliability Controls
# When LLM_PRIVACY_MODE=true, any prompt containing user-specific data forces local Ollama
LLM_PRIVACY_MODE=false
LLM_TIMEOUT_MS=60000
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_ITEMS=500
AI_GLOBAL_RATE_LIMIT_PER_MIN=60
AI_USER_RATE_LIMIT_PER_MIN=15

# ============================================================================
# 5. MANDI PRICES (Agmarknet / data.gov.in with 6h cache & samplePrices.json fallback)
# ============================================================================
# Get your free API key at https://data.gov.in/user/register
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ============================================================================
# 6 & 12a. FIREBASE PHONE OTP & GOOGLE OAUTH (Optional, hidden if blank)
# ============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
GOOGLE_CLIENT_ID=

# ============================================================================
# 7. NOTIFICATIONS: EMAIL (Nodemailer) + SMS (MSG91 / Twilio) + WHATSAPP CLOUD API
# ============================================================================
# Email via SMTP / Nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgriConnect <no-reply@agriconnect.in>
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# SMS via MSG91 or Twilio (if blank, logs to console in dev mode)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AGRICN
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API (Meta Graph API - if blank, logs to console in dev mode)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# ============================================================================
# 8. MAPS, DISTANCE & TRANSPORT COST ESTIMATE
# ============================================================================
# Configurable transport rate in INR per km per metric tonne
TRANSPORT_RATE_PER_KM_PER_TONNE=18
# External transport booking redirect URL (no fake API integration)
TRANSPORT_BOOKING_URL=https://porter.in/

# ============================================================================
# 12c & 12e. WEATHER WIDGET & OPTIONAL SENTRY HOOK
# ============================================================================
# OpenWeather API key (cached 30 minutes on backend; falls back to regional estimate if blank)
OPENWEATHER_API_KEY=
# Optional Sentry DSN for error monitoring
SENTRY_DSN=
